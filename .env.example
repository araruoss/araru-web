# Prefixo completo da API. Use /api com proxy/reverse proxy no mesmo domínio.
# Em deploy separado, também são aceitos http://localhost:3001 e
# https://api.exemplo.com; o frontend acrescenta /api quando não há path.
VITE_API_URL=/api

# Destino do proxy usado somente pelo Vite em desenvolvimento.
VITE_DEV_PROXY_TARGET=http://localhost:3001

# Hosts adicionais aceitos pelo Vite, separados por vírgula (ngrok, LAN etc.).
VITE_ALLOWED_HOSTS=
